# Mailfold 비밀 값 예시
# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.
#
# 여기에는 계정의 이메일과 앱 비밀번호만 적습니다.
#   <서버><번호>_EMAIL      이메일 주소
#   <서버><번호>_PASSWORD   앱 비밀번호 (Gmail 앱 비밀번호의 공백은 있어도 되고 없어도 됩니다)
#   <서버><번호>_LOGIN      (선택) 로그인 아이디가 기본 규칙과 다를 때만
#
# <서버>는 config/providers.json의 키(gmail, naver 등)를 대문자로 쓴 것입니다.
# <번호>는 서버마다 1부터 붙입니다. 계정 ID는 이 둘을 소문자로 붙인 것입니다 (GMAIL2_EMAIL → gmail2).
# 같은 키를 두 번 쓰면 오류가 납니다. 계정을 추가할 때는 번호를 하나 올리세요.
#
# 별칭("개인 네이버"), 보내는 사람 이름, 휴지통 폴더 같은 비밀이 아닌 설정은
# config/accounts.json에 적습니다 (config/accounts.example.json 참고).

# ===== Gmail =====
# 로그인 아이디: 이메일 전체
GMAIL1_EMAIL=you@gmail.com
GMAIL1_PASSWORD=xxxx xxxx xxxx xxxx

GMAIL2_EMAIL=you.work@gmail.com
GMAIL2_PASSWORD=xxxx xxxx xxxx xxxx

# ===== 네이버 =====
# 로그인 아이디: @naver.com 앞의 아이디 (you). 접속이 안 되면 아래처럼 이메일 전체로 덮어써 보세요.
NAVER1_EMAIL=you@naver.com
NAVER1_PASSWORD=your-app-password
# NAVER1_LOGIN=you@naver.com

# ===== 새 메일 서버 추가하기 =====
# 1) config/providers.json에 항목을 추가합니다. 키는 소문자 영문만 씁니다. 예:
#      "daum": { "label": "다음", "strategy": "imap",
#                "imap": { "host": "imap.daum.net", "port": 993, "secure": true },
#                "smtp": { "host": "smtp.daum.net", "port": 465, "secure": true },
#                "login": "email" }
#    strategy: "gmail"(Gmail 전용 확장 사용) 또는 "imap"(일반)
#    login:    "email"(이메일 전체) 또는 "localpart"(@ 앞부분)
# 2) 여기에 DAUM1_EMAIL, DAUM1_PASSWORD를 적습니다.
# 3) npm run probe -- daum1 로 접속과 휴지통 폴더를 확인합니다.
